# 安卓应用描述（供 platforms/android 的打包脚本读取）
#
# 高速过滤器客户端（HsfClient）的安卓应用目录。打包脚本
# （platforms/android/build_apk.sh 与 pack_apk.ps1）按「应用目录」参数
# 切换，本目录提供：
#   AndroidManifest.xml —— 应用 id / 原生库名 / 应用名 / 权限（唯一事实源，
#                          打包脚本从中派生包名与 .so 名）
#   app.env（本文件）   —— 构建侧信息（CMake 目标 / 构建目录前缀 / 产物名）
#
# 用法：
#   bash platforms/android/build_apk.sh x86_64 HighSpeedFilter/client/android
#   powershell -File platforms\android\pack_apk.ps1 -AppDir HighSpeedFilter\client\android

# CMake 目标名（根工程里编译出 libxhsfclient.so 的目标，见
# HighSpeedFilter/CMakeLists.txt 的 xhsfclient）。
APP_TARGET=xhsfclient
# 原生库构建目录前缀：out/<前缀>-<abi>/。
# ⚠ 必须与 platforms/android/CMakeLists.txt 的 ANDROID_BUILD_DIR 一致；
#   且**必须与 demo 的目录分开**——字体目录宏 XFONT_EXTERNAL_FT_FONT_DIR
#   是构建树级常量（被静态库内的 XFontFt.c 消费），一棵树只能服务一个
#   应用 id，两应用共用一棵树会「字库释放到 A、FT 去 B 找」→ 中文整片
#   缺失（真机事故记录见 platforms/android/README.md）。
APP_BUILD_PREFIX=android-hsf
# 产物名（落在 platforms/android/out/ 下）。
APP_APK_NAME=HsfClient-debug.apk
