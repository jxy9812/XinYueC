// Win32 VERSIONINFO 资源（configure_file 由 CMake 注入版本）：
// 资源管理器属性页/安装器/升级器按此读取文件版本与产品信息（对标 qmake
// 在 Windows 自动生成的版本资源）。纯 ASCII 规避 rc.exe 代码页问题。
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @XUPGRADE_PRODUCT_VERSION_RC@,0
 PRODUCTVERSION @XUPGRADE_PRODUCT_VERSION_RC@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "XinYueC"
            VALUE "FileDescription", "XinYueC XGui Controls Demo"
            VALUE "FileVersion", "@XUPGRADE_PRODUCT_VERSION@"
            VALUE "InternalName", "XGuiWindowDemo"
            VALUE "LegalCopyright", "Copyright (C) 2026 XinYueC Team"
            VALUE "OriginalFilename", "XGuiWindowDemo_Test.exe"
            VALUE "ProductName", "XinYueC XGui Demo"
            VALUE "ProductVersion", "@XUPGRADE_PRODUCT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
