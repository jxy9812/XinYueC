{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Android APK (x86_64)",
      "description": "独立子工程：原生库由根工程 xguidemo 目标编译，本工程只做编排（lib/apk/install-apk）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build_android",
      "cacheVariables": {
        "ANDROID_ABI_NAME": "x86_64",
        "ANDROID_API_LEVEL": "24"
      }
    },
    {
      "name": "arm64",
      "displayName": "Android APK (arm64-v8a)",
      "inherits": "default",
      "binaryDir": "${sourceDir}/../../build_android_arm64",
      "cacheVariables": {
        "ANDROID_ABI_NAME": "arm64-v8a"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "apk",
      "displayName": "编译 + 打包 APK",
      "configurePreset": "default",
      "targets": ["apk"]
    },
    {
      "name": "lib",
      "displayName": "只编译原生库",
      "configurePreset": "default",
      "targets": ["lib"]
    },
    {
      "name": "install",
      "displayName": "安装并启动到设备",
      "configurePreset": "default",
      "targets": ["install-apk"]
    }
  ]
}
