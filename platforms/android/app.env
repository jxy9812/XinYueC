# 安卓应用描述（供 platforms/android 的打包脚本读取）
#
# 本目录是**平台层自带的模板应用**（XGuiDemo）的应用目录。打包脚本
# （build_apk.sh / pack_apk.ps1）从本目录读取：
#   AndroidManifest.xml —— 应用 id / 原生库名 / 应用名 / 权限（唯一事实源）
#   app.env（本文件）   —— 构建侧信息（CMake 目标 / 构建目录前缀 / 产物名）
#
# 其它应用把这两个文件放在自己那边（如 HighSpeedFilter/client/android/），
# 打包脚本按应用目录参数切换，平台层不堆各应用的文件。
#
# 目标名须与根 CMakeLists 里对应的安卓目标一致（Test/CMakeLists.txt 的
# xguidemo）；构建目录前缀须与 platforms/android/CMakeLists.txt 的
# ANDROID_BUILD_DIR 一致（out/android-<abi>）。

# CMake 目标名（根工程里编译出该 .so 的目标）。
APP_TARGET=xguidemo
# 原生库构建目录前缀：out/<前缀>-<abi>/（桌面构建树之外的独立目录）。
APP_BUILD_PREFIX=android
# 产物名（落在 platforms/android/out/ 下）。
APP_APK_NAME=XGuiDemo-debug.apk
