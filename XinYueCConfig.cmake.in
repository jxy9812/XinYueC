@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
set(@EXPORT_NAME@_FOUND TRUE)

#添加头文件
set(@EXPORT_NAME@_INCLUDE_DIRS  @PACKAGE_INCLUDE_DIRS@)
include_directories(${@EXPORT_NAME@_INCLUDE_DIRS})
unset(@EXPORT_NAME@_INCLUDE_DIRS)

#导出@EXPORT_NAME@_INCLUDE_DIRS和@EXPORT_NAME@_LIBRARIES变量
include("${CMAKE_CURRENT_LIST_DIR}/@EXPORT_NAME@Targets.cmake")
